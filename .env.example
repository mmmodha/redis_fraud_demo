# Fraud Command Center demo — environment variables.
# Copy this file to `.env` and fill in the values. NEVER commit `.env`.
# Order below mirrors the wave it is first needed.

# ---- Redis Cloud (Wave 2a) -----------------------------------------------
# Connection string to your Redis Cloud database (RediSearch + RedisJSON
# must be enabled). Format: redis://default:<password>@<host>:<port>
# or rediss:// for TLS. Get it from app.redislabs.com → Database details
# → Public endpoint.
REDIS_URL=

# ---- Context Retriever (Wave 2b) -----------------------------------------
# Admin key generated in Redis Cloud → Context Retriever → Manage admin
# keys. Used only by `make context-up` to bootstrap the surface; the
# backend itself never needs it. See docs/context-retriever-setup.md.
CTX_ADMIN_KEY=

# Auto-populated by `make context-up` — do not edit by hand.
# The surface id and agent key the backend uses to call MCP tools.
CTX_SURFACE_ID=
CTX_AGENT_KEY=

# ---- Anthropic Claude (Wave 3) -------------------------------------------
# API key with Claude Sonnet access. Required when AGENT_MODE=claude.
# Optional (ignored) when AGENT_MODE=stub.
ANTHROPIC_API_KEY=

# Which Anthropic model the backend calls when AGENT_MODE=claude. Leave at
# the default unless you have access to a newer Sonnet checkpoint and want
# to point the demo at it. The value is a public Anthropic model identifier,
# not a secret.
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Which agent backs /decide and /chat:
#   claude — call Anthropic Claude with tool-use (default for the live demo).
#   stub   — deterministic offline-rehearsal mode; no Anthropic key needed,
#            useful if the network or API is flaky on stage.
AGENT_MODE=claude

# ---- Postgres (source bank DB) -------------------------------------------
# Defaults below are fine for the demo; only override if you swap the
# Docker Compose postgres service for a different DB.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=bank
POSTGRES_USER=bank
POSTGRES_PASSWORD=bank
