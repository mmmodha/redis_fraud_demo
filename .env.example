# Fraud Command Center demo — environment variables.
# Copy this file to `.env` and fill in the values. NEVER commit `.env`.
# Order below mirrors the wave it is first needed.
#
# Each variable carries:
#   - REQUIRED / OPTIONAL flag
#   - Behaviour when blank (the "mock-fallback" — what the stack does if you
#     leave the value empty)
# Variables listed as OPTIONAL can be omitted entirely; the documented
# fallback applies. Variables listed as REQUIRED must be set or the
# relevant component will refuse to start (or fall back to a stub mode
# that is NOT suitable for the live demo).

# ---- Redis (Wave 2a) -----------------------------------------------------
# OPTIONAL. Connection string to an external Redis (Redis Cloud or any
# RediSearch + RedisJSON-enabled deployment). Format:
#   redis://default:<password>@<host>:<port>   (plaintext)
#   rediss://default:<password>@<host>:<port>  (TLS)
# Get it from app.redislabs.com → Database details → Public endpoint.
# If blank: `make demo` activates the bundled `redis-stack` profile in
# infra/docker-compose.yml and every service talks to
# `redis://redis-stack:6379`. This is the zero-config path — no managed
# Redis required, suitable for local development and rehearsals.
# Set this to point at Redis Cloud for the presenter / on-stage path.
REDIS_URL=

# ---- Context Retriever (Wave 2b) -----------------------------------------
# OPTIONAL. Admin key generated in Redis Cloud → Context Retriever →
# Manage admin keys. Used only by `make context-up` to bootstrap the
# surface; the backend itself never needs it. See
# docs/context-retriever-setup.md.
# If blank: `make context-up` aborts with a clear error; the rest of the
# stack runs unaffected.
CTX_ADMIN_KEY=

# Auto-populated by `make context-up` — do not edit by hand.
# OPTIONAL. The surface id and agent key the backend uses to call MCP
# tools. If blank: the backend skips Context Retriever construction
# (Backends.ctx=None). Real-tool agents (`claude` / `stub`) will return a
# clean error if a CR-dependent tool is invoked; the mock-Claude path
# never calls a tool so it runs unaffected.
CTX_SURFACE_ID=
CTX_AGENT_KEY=

# ---- Anthropic Claude (Wave 3) -------------------------------------------
# REQUIRED when AGENT_MODE=claude; OPTIONAL when AGENT_MODE=stub.
# API key with Claude Sonnet access.
# If blank with AGENT_MODE=claude: backend startup fails. With
# AGENT_MODE=stub the value is ignored.
ANTHROPIC_API_KEY=

# OPTIONAL. Which Anthropic model the backend calls when AGENT_MODE=claude.
# Public Anthropic model identifier — NOT a secret. Leave at the default
# unless you have access to a newer Sonnet checkpoint.
# If blank: backend uses the default `claude-sonnet-4-5-20250929`.
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# OPTIONAL. Which agent backs /agent/score and /chat:
#   claude — call Anthropic Claude with tool-use (presenter mode).
#   stub   — deterministic offline-rehearsal mode that drives the REAL IRIS
#            tools against Redis; used by the backend test suite.
#   mock   — MockClaudeClient (Wave 8b): canned per-hero SSE traces with
#            artificial delays so the trace UI flickers without an
#            Anthropic key OR a populated Redis.
# If blank: the backend auto-detects — `claude` when ANTHROPIC_API_KEY is
# present, `mock` otherwise. Set this only to force a specific mode.
AGENT_MODE=

# ---- Postgres (source bank DB) -------------------------------------------
# OPTIONAL. Defaults below match the Compose postgres service; only
# override if you swap the Compose service for a different DB.
# If blank: the backend / RDI / data scripts fall back to
# host=postgres, port=5432, db=bank, user=bank, password=bank
# (the in-Compose defaults). POSTGRES_PASSWORD is the only one that is
# secret-ish in practice — change it in production deployments.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=bank
POSTGRES_USER=bank
POSTGRES_PASSWORD=bank

# OPTIONAL. Full Postgres URL override consumed by the `data` package
# (seed / verification scripts). Format:
#   postgresql://<user>:<password>@<host>:<port>/<db>
# If blank: `data.db.database_url()` builds the URL from POSTGRES_* above.
# Set this only when pointing at a Postgres that is NOT addressable via
# the POSTGRES_* tuple (e.g. a hosted DB with an extra path or sslmode).
DATABASE_URL=

# ---- Backend / worker runtime knobs --------------------------------------
# OPTIONAL. Python logging level for the RDI processor (DEBUG / INFO /
# WARNING / ERROR).
# If blank: defaults to INFO.
LOG_LEVEL=INFO

# OPTIONAL. Stable consumer name for the feature-worker's Redis Stream
# consumer group. Use a fixed value (e.g. `fw-1`) when you want a single
# worker to resume from the same position across restarts.
# If blank: the worker generates `fw-<pid>` at startup (fine for the demo
# but means each restart joins as a new consumer).
FEATURE_CONSUMER_NAME=

# ---- Frontend runtime / build knobs --------------------------------------
# OPTIONAL. Internal URL the Next.js `/api/*` proxy uses to reach the
# backend from inside the frontend container. Read at runtime.
# If blank: defaults to `http://backend:8000` (the Compose service name).
# Override only when running the frontend outside Compose.
BACKEND_INTERNAL_URL=

# OPTIONAL. Public-facing backend URL baked into the browser bundle. Used
# by the frontend's API client (and by Playwright config). The production
# Compose build leaves this blank so the browser talks to `/api` (proxied
# server-side via BACKEND_INTERNAL_URL).
# If blank: client uses `/api`; Playwright config uses
# `http://localhost:8000`.
NEXT_PUBLIC_BACKEND_URL=

# OPTIONAL. Local dev port for `make frontend-dev` and Playwright's
# managed dev server.
# If blank: defaults to 3030.
FRONTEND_PORT=3030

# OPTIONAL. Feature flag (string "true" to enable) for the "Clear demo
# cache" button in the TopBar. Bake at build time, same as the link vars
# below.
# If blank: button is hidden.
NEXT_PUBLIC_DEMO_CACHE_CLEAR=

# ---- TopBar links (frontend) ---------------------------------------------
# Three links shown in the page header. Baked at build time — change values
# and rebuild the frontend container to pick them up:
#   docker compose -f infra/docker-compose.yml --env-file .env build frontend
#   docker compose -f infra/docker-compose.yml --env-file .env up -d frontend

# OPTIONAL. Redis Cloud Console — your Redis Cloud subscription/database
# page. Get from app.redislabs.com → Database → "Open Database".
# If blank: defaults to https://app.redislabs.com/ (generic landing page).
NEXT_PUBLIC_REDIS_CLOUD_URL=https://app.redislabs.com/

# OPTIONAL. Context Retriever — direct link to your Context Retriever
# surface so the audience can see exactly where the demo is pulling its
# context from. Copy the URL from the address bar of your surface page.
# If blank: the TopBar link is hidden.
NEXT_PUBLIC_CONTEXT_RETRIEVER_URL=

# OPTIONAL. GitHub repo for this demo — used once the repo is public so
# audience members can clone and run it themselves.
# If blank: the TopBar link is hidden.
NEXT_PUBLIC_GITHUB_URL=
