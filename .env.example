# Anthropic Claude API key (used by the fraud-detection agent).
ANTHROPIC_API_KEY=

# Redis Cloud connection string for your database.
# Required. Format: redis://default:<password>@<host>:<port>
# Get this from https://app.redislabs.com — Database details → Public endpoint.
REDIS_URL=

# Redis Context Retriever API endpoint (managed service); supplied by the presenter before Wave 2.
CONTEXT_RETRIEVER_URL=

# Redis Context Retriever API key; supplied by the presenter before Wave 2.
CONTEXT_RETRIEVER_API_KEY=

# Postgres (source bank DB) settings. These defaults are fine for the demo.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=bank
POSTGRES_USER=bank
POSTGRES_PASSWORD=bank
