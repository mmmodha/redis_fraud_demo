# Fraud Command Center — environment template
# Copy to `.env` and fill in ONLY the values under "You set".
# Never commit `.env`.
#
# Zero-config path: leave everything blank → `make demo` uses
# bundled redis-stack + mock agent (no Redis Cloud / Anthropic needed).

# =============================================================================
# YOU SET — fill these for your environment
# =============================================================================

# --- Redis -------------------------------------------------------------------
# Leave blank → bundled redis-stack (local rehearsal).
# Set for Redis Cloud / presenter path:
#   redis://default:<password>@<host>:<port>
#   rediss://default:<password>@<host>:<port>   (TLS)
REDIS_URL=

# --- Anthropic (live Claude agent) -------------------------------------------
# Leave blank → mock/stub agent (deterministic hero traces).
# Set for real Claude tool-use on stage.
ANTHROPIC_API_KEY=

# Force agent mode (optional). Leave blank to auto-detect:
#   ANTHROPIC_API_KEY set → claude | else → mock
# Values: claude | stub | mock
AGENT_MODE=

# Optional model id when AGENT_MODE=claude (default: claude-sonnet-4-5-20250929)
# ANTHROPIC_MODEL=

# --- Context Retriever (Redis Cloud managed CR) ------------------------------
# Leave blank → skip CR provisioning; demo still runs (mock/stub tooling).
# Required for `make context-up` / auto-provision during `make demo`
# when using Redis Cloud. Generate in Redis Cloud → Context Retriever →
# Manage admin keys.
CTX_ADMIN_KEY=

# Optional surface name when sharing a Redis Cloud tenant (default:
# fraud-command-center). A new name creates a SECOND surface.
CTX_SURFACE_NAME=

# --- LangCache (optional managed semantic cache for chat) --------------------
# Leave all three blank → local Redis semantic cache.
# When all three are set → managed LangCache.
LANGCACHE_SERVER_URL=
LANGCACHE_CACHE_ID=
LANGCACHE_API_KEY=

# --- TopBar links (optional; rebuild frontend after changing) ----------------
# Redis Cloud console URL (default: https://app.redislabs.com/)
NEXT_PUBLIC_REDIS_CLOUD_URL=

# Public GitHub repo link (hidden if blank)
NEXT_PUBLIC_GITHUB_URL=

# Show "Clear demo cache" button in TopBar (set to true to enable)
# NEXT_PUBLIC_DEMO_CACHE_CLEAR=true

# =============================================================================
# AUTO-WRITTEN — do not edit; filled by `make context-up` / `make demo`
# =============================================================================
# When REDIS_URL + CTX_ADMIN_KEY are set, `make demo` runs context-up and
# writes these. The backend uses CTX_AGENT_KEY to call CR tools.
# NEXT_PUBLIC_CONTEXT_RETRIEVER_URL is derived as:
#   https://app.redislabs.com/#/context-retriever/<CTX_SURFACE_ID>
CTX_SURFACE_ID=
CTX_AGENT_KEY=
NEXT_PUBLIC_CONTEXT_RETRIEVER_URL=

# =============================================================================
# ADVANCED — compose defaults; change only if you know you need to
# =============================================================================
# Postgres (compose service defaults — leave unless pointing elsewhere)
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# POSTGRES_DB=bank
# POSTGRES_USER=bank
# POSTGRES_PASSWORD=bank
# DATABASE_URL=

# LangCache similarity (0.0–1.0; default 0.85 if unset)
# LANGCACHE_SIMILARITY_THRESHOLD=0.85
# LANGCACHE_SEMANTIC_THRESHOLD=0.85

# Local frontend / Playwright (`make ui`)
# FRONTEND_PORT=3030
# NEXT_PUBLIC_BACKEND_URL=
# BACKEND_INTERNAL_URL=
